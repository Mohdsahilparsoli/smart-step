# Copy this file to .env and fill in your real SMTP details.
# These are DUMMY placeholder values — the contact form will not send real
# email until you replace them with a real SMTP account (Gmail app password,
# SendGrid, Mailgun, Zoho Mail, your hosting provider's SMTP, etc).

# SMTP server host, e.g. smtp.gmail.com / smtp.zoho.com / smtp.sendgrid.net
SMTP_HOST=smtp.example.com

# SMTP port — commonly 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587

# Set to "true" only if using port 465 (implicit SSL). Leave "false" for 587/STARTTLS.
SMTP_SECURE=false

# SMTP login credentials
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-or-app-password

# The "From" address on outgoing mail. Often needs to match/be authorized by
# your SMTP provider — falls back to SMTP_USER if left blank.
CONTACT_FROM_EMAIL=no-reply@smartstepssiddharthvihar.com

# Where enquiry form submissions should be delivered.
CONTACT_TO_EMAIL=info@smartstepssiddharthvihar.com

# Production domain (also used for canonical URLs, sitemap, robots.txt).
PUBLIC_SITE_URL=https://www.smartstepssiddharthvihar.com
