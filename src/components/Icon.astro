---
// Lightweight, stroke-based line icons (Feather/Lucide-style) used across the site
// instead of emoji. All icons inherit color via currentColor.

export interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  phone: '<path d="M4.5 3.5h3.2c.5 0 .95.35 1.05.85l.8 3.6a1.1 1.1 0 0 1-.3 1.05L7.7 10.5a12.3 12.3 0 0 0 5.8 5.8l1.5-1.55a1.1 1.1 0 0 1 1.05-.3l3.6.8c.5.1.85.55.85 1.05v3.2c0 .6-.5 1.1-1.1 1.1C10.8 20.6 3.4 13.2 3.4 4.6c0-.6.5-1.1 1.1-1.1Z"/>',
  whatsapp: '<path d="M6.5 17.5 5 21l3.6-1.5A8.5 8.5 0 1 0 5.5 15l1 2.5Z"/><path d="M9 9.6c0-.4.3-.7.7-.7h.7c.2 0 .5.15.6.4l.6 1.4c.1.25.05.55-.1.75l-.5.6a5.6 5.6 0 0 0 2.6 2.6l.6-.5c.2-.15.5-.2.75-.1l1.4.6c.25.1.4.35.4.6v.7c0 .4-.3.7-.7.7-3.6 0-7-3.4-7-7Z"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.2"/>',
  key: '<circle cx="8" cy="15" r="3.2"/><path d="M10.3 12.7 18 5l2 2-1.6 1.6 1.6 1.6-2 2-1.6-1.6-1.9 1.9"/>',
  tag: '<path d="M3.5 12.7V5.5c0-.55.45-1 1-1h7.2c.27 0 .52.1.7.3l8 8a1 1 0 0 1 0 1.4l-7.2 7.2a1 1 0 0 1-1.4 0l-8-8a1 1 0 0 1-.3-.7Z"/><circle cx="8" cy="8.5" r="1.3"/>',
  building: '<rect x="5" y="3.5" width="10" height="17" rx="0.8"/><path d="M15 9h4v11.5h-4"/><path d="M8 7.5h.01M11.5 7.5h.01M8 11h.01M11.5 11h.01M8 14.5h.01M11.5 14.5h.01"/>',
  building2: '<path d="M4 20.5V9.5l6-4 6 4v11"/><path d="M20 20.5V13l-4-2.4"/><path d="M9 20.5v-4h2v4M13 20.5v-4"/>',
  handshake: '<path d="M3.5 12.5 7 9l3 2.2 3-2.6 3.5 3-1.3 3.3-2.4 2.3H9l-2.6-2.6"/><path d="M13 11.2 15.7 8l3.8 3.5-1.1 3.2"/>',
  'trending-up': '<path d="M3.5 16.5 9 11l4 3 7-7.5"/><path d="M15.5 6.5h4.5v4.5"/>',
  home: '<path d="M4 11.5 12 4l8 7.5"/><path d="M6 10.5v9.5h12v-9.5"/><path d="M10 20v-5h4v5"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="0.8"/><rect x="13" y="4" width="7" height="7" rx="0.8"/><rect x="4" y="13" width="7" height="7" rx="0.8"/><rect x="13" y="13" width="7" height="7" rx="0.8"/>',
  land: '<path d="M3.5 19.5 9 6.5l3 6 2-3.5 6.5 10.5Z"/><path d="M3.5 19.5h17"/>',
  check: '<circle cx="12" cy="12" r="8.5"/><path d="M8.2 12.3 10.8 15l5-6"/>',
  'check-circle': '<circle cx="12" cy="12" r="8.5"/><path d="M8.2 12.3 10.8 15l5-6"/>',
  file: '<path d="M7 3.5h7l4 4v13H7z"/><path d="M14 3.5v4h4"/><path d="M9.5 12.5h5M9.5 15.5h5"/>',
  users: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 19.5c0-2.2 1.6-4 3.9-4.6"/>',
  link: '<path d="M9.5 14.5 14.5 9.5"/><path d="M11 7.2 13 5.2a3.3 3.3 0 0 1 4.7 4.7l-2 2"/><path d="M13 16.8l-2 2a3.3 3.3 0 0 1-4.7-4.7l2-2"/>',
  compass: '<circle cx="12" cy="12" r="8.5"/><path d="M15 9l-1.8 4.2L9 15l1.8-4.2Z"/>',
  clipboard: '<rect x="6" y="4.5" width="12" height="16" rx="1"/><rect x="9" y="3" width="6" height="3" rx="0.8"/><path d="M9 11h6M9 14.5h6M9 18h4"/>',
  briefcase: '<rect x="3.5" y="8" width="17" height="11" rx="1.2"/><path d="M8.5 8V6a1.5 1.5 0 0 1 1.5-1.5h4A1.5 1.5 0 0 1 15.5 6v2"/><path d="M3.5 13h17"/>',
  'arrow-right': '<path d="M4.5 12h15"/><path d="M13 6l6 6-6 6"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.2"/><path d="M4.5 6.5 12 12.5l7.5-6"/>'
};

const path = icons[name] ?? '';
---

<svg
  class={`icon icon-${name} ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={path}
/>

<style>
  .icon {
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
  }
</style>
