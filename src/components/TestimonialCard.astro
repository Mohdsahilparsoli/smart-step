---
export interface Props {
  quote: string;
  name: string;
  context: string;
}

const { quote, name, context } = Astro.props;
---

<div class="card testimonial-card">
  <p class="testimonial-badge">Sample testimonial</p>
  <p class="quote">"{quote}"</p>
  <div class="testimonial-meta">
    <span class="name">{name}</span>
    <span class="context">{context}</span>
  </div>
</div>

<style>
  .testimonial-card {
    padding: 1.9rem 1.7rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .testimonial-badge {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold);
    font-weight: 700;
    margin: 0;
  }

  .quote {
    font-size: 1.02rem;
    color: var(--color-text-dark);
    font-style: italic;
    flex: 1;
    margin: 0;
  }

  .testimonial-meta {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
    padding-top: 0.8rem;
  }

  .name { font-weight: 700; color: var(--color-deep-green); font-size: 0.95rem; }
  .context { font-size: 0.85rem; color: var(--color-text-muted); }
</style>
