---
import { whatsappLink } from '../data/site.js';
---

<a
  class="floating-whatsapp"
  href={whatsappLink('general')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Smart Steps on WhatsApp"
>
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M16.04 3C9.4 3 4 8.34 4 14.9c0 2.24.63 4.34 1.72 6.14L4 29l8.2-2.14a12.6 12.6 0 0 0 3.84.6C22.68 27.46 28 22.12 28 15.56 28 9 22.68 3 16.04 3zm0 22.7c-1.3 0-2.55-.24-3.72-.7l-.27-.1-4.87 1.27 1.3-4.75-.17-.3a10.4 10.4 0 0 1-1.6-5.42c0-5.7 4.6-10.3 10.33-10.3 5.72 0 10.32 4.6 10.32 10.3 0 5.7-4.6 10-10.32 10zm5.68-7.7c-.31-.16-1.83-.9-2.11-1-.28-.1-.49-.16-.7.16-.2.31-.8 1-.98 1.2-.18.21-.36.23-.67.08-.31-.16-1.3-.48-2.48-1.53-.92-.82-1.54-1.83-1.72-2.14-.18-.31-.02-.48.14-.63.14-.14.31-.36.47-.55.16-.18.2-.31.31-.52.1-.2.05-.39-.02-.55-.08-.16-.7-1.7-.96-2.32-.25-.6-.5-.52-.7-.53h-.6c-.2 0-.52.08-.8.39-.27.31-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.16.2 2.09 3.2 5.06 4.48.7.3 1.25.48 1.68.62.7.22 1.34.19 1.85.12.56-.08 1.83-.75 2.09-1.47.26-.72.26-1.34.18-1.47-.08-.13-.28-.2-.6-.36z"/>
  </svg>
  <span class="visually-hidden">Chat on WhatsApp</span>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #1EA952;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 22px rgba(6, 62, 50, 0.28);
    z-index: 90;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .floating-whatsapp:hover {
    transform: scale(1.06);
    box-shadow: 0 10px 26px rgba(6, 62, 50, 0.34);
  }

  @media (max-width: 560px) {
    .floating-whatsapp {
      width: 52px;
      height: 52px;
      right: 0.85rem;
      bottom: 0.85rem;
    }
  }
</style>
