---
import { whatsappLink } from '../data/site.js';
import Icon from './Icon.astro';

export interface Props {
  project: {
    slug: string;
    name: string;
    location: string;
    typeLabel: string;
    status?: string;
    image: string;
    imageAlt: string;
    description: string;
    isPlaceholder?: boolean;
  };
}

const { project } = Astro.props;
---

<article class="card project-card">
  <div class="project-media">
    <img
      src={project.image}
      alt={project.imageAlt}
      width="480"
      height="320"
      loading="lazy"
    />
    {project.isPlaceholder && <span class="badge">Sample Listing</span>}
    <span class="tag">{project.typeLabel}</span>
  </div>
  <div class="project-body">
    <h3>{project.name}</h3>
    <p class="project-location"><Icon name="pin" size={15} /> {project.location}</p>
    <p class="project-desc">{project.description}</p>
    <div class="btn-row">
      <a
        class="btn btn-whatsapp btn-sm"
        href={whatsappLink('project')}
        target="_blank"
        rel="noopener noreferrer"
      ><Icon name="whatsapp" size={15} /> Enquire Now</a>
    </div>
  </div>
</article>

<style>
  .project-card { display: flex; flex-direction: column; }

  .project-media {
    position: relative;
    aspect-ratio: 4 / 2.7;
    overflow: hidden;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .project-media img { transform: scale(1.05); }

  .badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    background: rgba(6,62,50,0.85);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .tag {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    background: var(--color-gold);
    color: var(--color-deep-green);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }

  .project-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .project-body h3 { margin-bottom: 0.1rem; }

  .project-location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--color-emerald);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .project-desc {
    font-size: 0.92rem;
    flex: 1;
    margin-bottom: 1rem;
  }

  .btn-sm {
    padding: 0.6em 1.05em;
    font-size: 0.85rem;
    min-height: 40px;
  }
</style>
