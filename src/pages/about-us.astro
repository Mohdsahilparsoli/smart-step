---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LocationCard from '../components/LocationCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTA from '../components/CTA.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../data/site.js';
import { getOrganizationSchema } from '../data/schema.js';

const siteUrl = Astro.site.toString();
const jsonLd = getOrganizationSchema(siteUrl);

const expertise = [
  { icon: 'home', title: 'Residential Property', description: 'Assistance across flats, apartments and residential plots.' },
  { icon: 'building', title: 'Commercial Property', description: 'Support for office and retail space requirements.' },
  { icon: 'compass', title: 'Local Property Markets', description: 'Working knowledge of Ghaziabad, Noida and nearby localities.' },
  { icon: 'clipboard', title: 'Understanding Requirements', description: 'Taking time to understand budget, location and property preferences.' },
  { icon: 'users', title: 'Customer Assistance', description: 'Staying available and responsive throughout the property search.' },
  { icon: 'handshake', title: 'Property Consultation', description: 'Practical, requirement-first guidance rather than a generic pitch.' }
];

const whyWorkWithUs = [
  { icon: 'check-circle', title: 'Requirement-First Approach', description: 'Every conversation begins with understanding what you actually need, not a fixed list of listings.' },
  { icon: 'pin', title: 'Local Presence', description: 'Based in Siddhart Vihar with familiarity across nearby Ghaziabad localities.' },
  { icon: 'phone', title: 'Direct Communication', description: 'Reach us easily by call or WhatsApp for updates and questions.' },
  { icon: 'compass', title: 'Coverage Across NCR', description: 'Assistance extended to Noida and the wider Delhi NCR region.' }
];

const areas = [
  { name: 'Siddhart Vihar', description: 'Our base location and the area we know best on the ground.' },
  { name: 'Ghaziabad', description: 'Residential and commercial assistance across Ghaziabad.' },
  { name: 'Noida', description: 'Support for buyers and investors exploring Noida.' },
  { name: 'Delhi', description: 'Assistance for property requirements within Delhi.' },
  { name: 'Delhi NCR', description: 'Coverage across the wider National Capital Region.' }
];
---

<BaseLayout
  title="About Smart Steps Siddhart Vihar | Real Estate Consultant in Ghaziabad"
  description="Learn about Smart Steps Siddhart Vihar, a real estate and property consultancy based in Ghaziabad, assisting clients across Siddhart Vihar, Noida and Delhi NCR."
  path="/about-us/"
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About Us' }]} />
  </div>

  <!-- 1. About Hero -->
  <Hero
    eyebrow="About Us"
    title="About Smart Steps Siddhart Vihar"
    subtitle="A real estate and property consultancy based in Siddhart Vihar, Ghaziabad, assisting buyers, sellers and investors across Ghaziabad, Noida and Delhi NCR."
    image="https://images.unsplash.com/photo-1526948531399-320e7e40f0ca?auto=format&fit=crop&w=1000&q=80"
    imageAlt="Two property consultants in a meeting discussing property options"
  />

  <!-- 2. Who We Are -->
  <section class="section">
    <div class="container narrow">
      <SectionHeading eyebrow="Who We Are" title="A Property Consultancy Rooted in Siddhart Vihar" />
      <p>
        {SITE.name} works with individuals and businesses looking for residential or commercial
        properties in and around Ghaziabad. We approach each enquiry as a conversation first 
        understanding what a client needs before pointing them toward relevant property options.
      </p>
      <p>
        Being based in Siddhart Vihar keeps us close to the localities we assist with most often,
        while our coverage extends to Noida and the wider Delhi NCR region.
      </p>
    </div>
  </section>

  <!-- 3. Our Story -->
  <section class="section section--alt">
    <div class="container narrow">
      <SectionHeading eyebrow="Our Story" title="Built Around Local Property Assistance" />
      <p>
        Smart Steps Siddhart Vihar was set up to give buyers and sellers in Ghaziabad a
        straightforward point of contact for their property needs. Rather than treating every
        enquiry the same way, our approach is to listen first  understanding a client's
        requirement, budget and timeline  and then work toward relevant property options.
      </p>
      <p>
        As our work continues across Ghaziabad, Noida and Delhi NCR, the same principle stays at
        the center: clear, honest communication throughout the property search process.
      </p>
    </div>
  </section>

  <!-- 4. Our Mission -->
  <section class="section">
    <div class="container two-col">
      <div class="card info-card">
        <h3>Our Mission</h3>
        <p>
          To make the property search process easier to navigate by offering clear guidance,
          honest communication and property options that genuinely match what a client is
          looking for.
        </p>
      </div>
      <div class="card info-card">
        <h3>Our Vision</h3>
        <p>
          To be a dependable, local point of contact for residential and commercial property
          requirements across Ghaziabad, Noida and Delhi NCR  known for professional,
          customer-focused assistance.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Our Vision (integrated above per two-col layout, expanded section below) -->
  <section class="section section--alt">
    <div class="container narrow">
      <SectionHeading eyebrow="Looking Ahead" title="Where We're Headed" />
      <p>
        As Ghaziabad, Noida and the wider Delhi NCR region continue to develop, our aim is to
        keep pace with client needs  helping more buyers, sellers and investors navigate their
        property decisions with confidence and clarity, one requirement at a time.
      </p>
    </div>
  </section>

  <!-- 6. Our Real Estate Expertise -->
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Expertise" title="Our Real Estate Expertise" />
      <div class="grid grid-3">
        {expertise.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
  </section>

  <!-- 7. Our Customer Approach -->
  <section class="section section--alt">
    <div class="container narrow">
      <SectionHeading eyebrow="Our Approach" title="How We Work With Clients" />
      <ul class="approach-list">
        <li><strong>Understanding requirements:</strong> We start by learning about your budget, location preference and property type.</li>
        <li><strong>Clear communication:</strong> Updates and answers are shared directly, without unnecessary jargon.</li>
        <li><strong>Relevant property options:</strong> We narrow down options based on what actually fits your requirement.</li>
        <li><strong>Assistance throughout the process:</strong> Support continues as you evaluate and move forward with a property.</li>
      </ul>
    </div>
  </section>

  <!-- 8. Areas We Serve -->
  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Coverage" title="Areas We Serve" />
      <div class="grid grid-4">
        {areas.map((area) => <LocationCard {...area} />)}
      </div>
    </div>
  </section>

  <!-- 9. Why Work With Smart Steps -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading eyebrow="Why Smart Steps" title="Why Work With Us" />
      <div class="grid grid-2">
        {whyWorkWithUs.map((item) => <ServiceCard {...item} />)}
      </div>
    </div>
  </section>

  <!-- 10. Final CTA -->
  <section class="section">
    <div class="container">
      <CTA
        title="Have a Property Requirement in Mind?"
        description="Get in touch and we'll help you look at relevant options in Ghaziabad, Noida or Delhi NCR."
        secondaryHref="/contact-us/"
        secondaryLabel="Contact Us"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 78ch; }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
  }
  .info-card { padding: 2rem; }
  .info-card p { margin: 0; font-size: 0.95rem; }
  .approach-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .approach-list li {
    padding-left: 1.4rem;
    position: relative;
    color: var(--color-text-muted);
  }
  .approach-list li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.5em;
    width: 8px; height: 8px;
    background: var(--color-gold);
    border-radius: 2px;
    transform: rotate(45deg);
  }
  .approach-list strong { color: var(--color-text-dark); }
  @media (max-width: 700px) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
